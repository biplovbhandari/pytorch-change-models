# Required
PROJECT_ID=your-gcp-project-id
BUCKET_URI=gs://your-gcs-bucket-name

# Optional (defaults shown)
# REGION=us-central1
# REPO_NAME=segment-any-change-repo
# IMAGE_NAME=segment-any-change-model-server
# MODEL_DISPLAY_NAME=segment-any-change-model
# ENDPOINT_DISPLAY_NAME=segment-any-change-model-endpoint
# DEPLOYED_MODEL_NAME=segment-any-change-model-deployed
# VERTEX_SERVICE_ACCOUNT_NAME=seg-anychange-endpoint-sa

# Machine config
# MACHINE_TYPE=n1-standard-8
# ACCELERATOR=type=nvidia-tesla-t4,count=1
# MIN_REPLICAS=1
# MAX_REPLICAS=1

# To skip image build and reuse an existing image:
# EXISTING_IMAGE_URI=us-central1-docker.pkg.dev/your-gcp-project-id/segment-any-change-repo/segment-any-change-model-server:v20250815-203753
